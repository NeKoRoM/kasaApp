<?xml version="1.0" encoding="utf-8"?>


<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.fragments.SettingsKasaFragment">

    <ScrollView
        android:id="@+id/scrollableView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="67dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="0dp"
            tools:context=".EditItem">

            <TextView
                android:id="@+id/textView2"
                android:layout_width="320dp"
                android:layout_height="40dp"

                android:layout_marginTop="60dp"
                android:text="Приховати непотрібні поля"
                android:textSize="24sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="HardcodedText" />

            <Switch
                android:id="@+id/sectionSwitch"
                android:layout_width="300dp"
                android:layout_height="40dp"
                android:layout_marginTop="70dp"
                android:text="Приховати відділ товарів"
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView2"
                tools:ignore="HardcodedText,UseSwitchCompatOrMaterialXml" />

            <Switch
                android:id="@+id/typeSwitch"
                android:layout_width="300dp"
                android:layout_height="40dp"
                android:layout_marginTop="130dp"
                android:text="Приховати тип ціни"
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView2"
                tools:ignore="HardcodedText,UseSwitchCompatOrMaterialXml" />

            <Switch
                android:id="@+id/salesCountSwitch"
                android:layout_width="300dp"
                android:layout_height="40dp"
                android:layout_marginTop="370dp"
                android:text="Приховати продана кількість"
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView2"
                tools:ignore="HardcodedText,UseSwitchCompatOrMaterialXml" />

            <Switch
                android:id="@+id/remainderSwitch"
                android:layout_width="300dp"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:text="Приховати залишок "
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView2"
                tools:ignore="HardcodedText,UseSwitchCompatOrMaterialXml" />

            <Switch
                android:id="@+id/bar2"
                android:layout_width="300dp"
                android:layout_height="40dp"
                android:layout_marginTop="190dp"
                android:text="Приховати штрих код 2 "
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView2"
                tools:ignore="HardcodedText,UseSwitchCompatOrMaterialXml" />

            <Switch
                android:id="@+id/bar3"
                android:layout_width="300dp"
                android:layout_height="40dp"
                android:layout_marginTop="250dp"
                android:text="Приховати штрих код 3                             "
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView2"
                tools:ignore="HardcodedText,UseSwitchCompatOrMaterialXml" />

            <Switch
                android:id="@+id/bar4"
                android:layout_width="300dp"
                android:layout_height="40dp"
                android:layout_marginTop="310dp"
                android:text="Приховати штрих код 4                             "
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView2"
                tools:ignore="HardcodedText,UseSwitchCompatOrMaterialXml" />

            <Switch
                android:id="@+id/salesAmountSwitch"
                android:layout_width="300dp"
                android:layout_height="40dp"
                android:layout_marginTop="430dp"
                android:text="Приховати продано на суму           "
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView2"
                tools:ignore="HardcodedText,UseSwitchCompatOrMaterialXml" />

            <Switch
                android:id="@+id/editUKTZED"
                android:layout_width="300dp"
                android:layout_height="40dp"
                android:layout_marginTop="490dp"
                android:text="Приховати УКТЗЕД           "
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView2"
                tools:ignore="HardcodedText,UseSwitchCompatOrMaterialXml" />

            <Switch
                android:id="@+id/editGroup"
                android:layout_width="300dp"
                android:layout_height="40dp"
                android:layout_marginTop="550dp"
                android:text="Приховати групу товарів           "
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView2"
                tools:ignore="HardcodedText,UseSwitchCompatOrMaterialXml" />

            <Switch
                android:id="@+id/spinnerPdv"
                android:layout_width="300dp"
                android:layout_height="40dp"
                android:layout_marginTop="610dp"
                android:text="Приховати групу ПОДАТКІВ           "
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView2"
                tools:ignore="HardcodedText,UseSwitchCompatOrMaterialXml" />
        </androidx.constraintlayout.widget.ConstraintLayout>


    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>