<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.fragments.SettingsUktzFragment"
    android:orientation="vertical"
    >

    <!-- TODO: Update blank fragment layout-->

    <EditText
        android:id="@+id/editTextName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:hint="назва УКТЗЕД"/>

    <EditText
        android:id="@+id/editTextValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:maxLength="10"
        android:inputType="number"

        android:hint="10 цифр УКТЗЕД" />

    <TextView
        android:visibility="gone"
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="     ВИБЕРІТЬ ГРУПУ ТОВАРУ           ВИБЕРІТЬ ГРУПУ ПДВ" />

    <LinearLayout
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal">

        <Spinner


        android:id="@+id/spinnerGroup"
        style="@android:style/Widget.Spinner"
        android:layout_width="200dp"
        android:layout_marginBottom="35dp"
        android:layout_height="50dp"
        android:popupBackground="#530960" />

        <Spinner
            android:id="@+id/spinnerPdv"
            style="@android:style/Widget.Spinner"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:layout_marginBottom="35dp"

            android:popupBackground="#530960" />

    </LinearLayout>



    <Button
        android:id="@+id/button2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/buttonAdListUktz" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#787878" />

</LinearLayout>