!.env.example
local.properties
*.keystore
*.jks
secring.gpg
credentials.json
google-services.json

# --- Operating System & IDE ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo
*~
*.bak

# --- Android / Java / Kotlin / Gradle ---
.gradle/
**/.gradle/
build/
**/build/
!build.gradle.kts
!settings.gradle.kts
dist/
**/dist/
.kotlin/
**/.kotlin/
captures/
**/captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.dex
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.jar
.jdk*/

# --- Python, Testing & Virtual Environments ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
*.egg-info/
.venv/
